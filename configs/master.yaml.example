# vcdeploy Master Configuration
# Copy to /etc/vcdeploy/master.yaml

server:
  listen: ":9000"
  https_address: ":9443"  # Optional separate HTTPS port
  tls:
    # TLS mode: "disabled", "static", or "acme"
    mode: "static"
    
    # Static mode: provide certificate and key files
    cert_file: /etc/vcdeploy/tls/cert.pem
    key_file: /etc/vcdeploy/tls/key.pem
    
    # ACME (Let's Encrypt) mode configuration
    acme:
      email: "admin@example.com"
      domains:
        - "vcdeploy.example.com"
      staging: false  # Set to true for testing
      cache_dir: /var/lib/vcdeploy/acme
    
    # Force HTTP to HTTPS redirect
    force_https: true
    
    # Minimum TLS version ("1.2" or "1.3")
    min_version: "1.2"

grpc:
  listen: ":9001"

# SSH settings (for provisioning and git repo access — not used for deployment)
ssh:
  default_user: deploy
  default_key: /etc/vcdeploy/keys/default.pem
  known_hosts: /etc/vcdeploy/known_hosts
  connection_timeout: 30s
  keepalive_interval: 15s
  idle_timeout: 60s
  
  # Jump servers (optional)
  # jump_servers:
  #   - name: bastion
  #     host: bastion.example.com
  #     user: jump
  #     key: /etc/vcdeploy/keys/bastion.pem

security:
  key_rotation:
    enabled: true
    interval: 720h  # 30 days
  session_timeout: 24h
  require_2fa_admin: true

backup:
  database:
    enabled: true
    interval: 720h   # 30 days
    retention: 8760h # 365 days
    path: /var/lib/vcdeploy/backups/
  config:
    versions: 5

logs:
  deployment:
    retention: 2160h  # 90 days
    max_size_mb: 100
  audit:
    retention: 8760h  # 365 days
    export:
      enabled: false
      destination: ""
      schedule: "0 0 1 * *"
  application:
    level: info
    retention: 720h  # 30 days
  rotation:
    schedule: "0 3 * * *"

webhooks:
  github:
    enabled: true
    path: /webhook/github
  gitlab:
    enabled: true
    path: /webhook/gitlab
  bitbucket:
    enabled: true
    path: /webhook/bitbucket

# Archive settings
archive:
  storage_dir: /var/lib/vcdeploy/archives
  keep_count: 10                    # Max cached archives per project
  max_total_size: 5GB               # Max total cache size
  signed_url_expiry: 10m            # HMAC signed URL expiry

notifications:
  providers:
    slack:
      enabled: true
    email:
      enabled: true
      smtp:
        host: smtp.example.com
        port: 587
        user: notifications@example.com
    webhook:
      enabled: true

api:
  enabled: true
  rate_limit:
    enabled: true
    requests_per_second: 10
    burst_size: 20

# Tracing configuration (OpenTelemetry)
tracing:
  enabled: false
  endpoint: "localhost:4317"
  service_name: "vcdeploy-master"

# Resource alerting thresholds
alerting:
  enabled: false
  cpu_threshold: 80
  memory_threshold: 85
  disk_threshold: 90

appearance:
  theme: dark
