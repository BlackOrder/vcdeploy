# Example Project Type Configuration
# Save to /etc/vcdeploy/types/<name>.yaml

name: laravel

# Shared directories (persist across releases)
shared_dirs:
  - storage

# Shared files (persist across releases)  
shared_files:
  - .env

# Writable directories (chmod for web server)
writable_dirs:
  - bootstrap/cache
  - storage

# Number of releases to keep
keep_releases: 5

# Validation rules
validation:
  # Files that must exist in the repository
  required_files:
    - artisan
    - composer.json
  
  # Environment variable validation
  env:
    required_keys:
      - APP_KEY
      - APP_ENV
      - DB_CONNECTION
    # Optional: regex patterns for validation
    # patterns:
    #   APP_KEY: "^base64:[A-Za-z0-9+/=]{44}$"

# Default hooks (can be overridden per project)
hooks:
  post_deploy:
    - composer install --no-dev --optimize-autoloader
    - php artisan migrate --force
    - php artisan config:cache
    - php artisan route:cache
    - php artisan view:cache
