# VCDeploy UI Test Environment

# Application URLs
VCDEPLOY_WEB_URL=http://localhost:8080
VCDEPLOY_API_URL=http://localhost:8080/api

# Test credentials - MUST match VCDEPLOY_ADMIN_PASSWORD set on the server
# The server syncs admin credentials from env vars on startup
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=Admin@Password123!

# Parallel execution (set to 'true' to disable parallel tests)
TEST_NO_PARALLEL=false

# CI mode (automatically set in CI environments)
# CI=true
